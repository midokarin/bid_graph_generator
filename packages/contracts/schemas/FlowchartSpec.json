{
  "$defs": {
    "FlowEdge": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "source": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Target",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "kind": {
          "enum": [
            "normal",
            "rework"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "id",
        "source",
        "target",
        "label",
        "kind"
      ],
      "title": "FlowEdge",
      "type": "object"
    },
    "FlowNode": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "maxLength": 80,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9_-]+$",
          "title": "Id",
          "type": "string"
        },
        "type": {
          "enum": [
            "start",
            "end",
            "process",
            "decision",
            "document",
            "subprocess"
          ],
          "title": "Type",
          "type": "string"
        },
        "text": {
          "maxLength": 200,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "level": {
          "maximum": 20,
          "minimum": 0,
          "title": "Level",
          "type": "integer"
        },
        "owner": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Owner"
        },
        "phase": {
          "anyOf": [
            {
              "maxLength": 200,
              "minLength": 1,
              "pattern": "\\S",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Phase"
        }
      },
      "required": [
        "id",
        "type",
        "text",
        "level",
        "owner",
        "phase"
      ],
      "title": "FlowNode",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "diagram_type": {
      "const": "flowchart",
      "title": "Diagram Type",
      "type": "string"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "pattern": "\\S",
      "title": "Title",
      "type": "string"
    },
    "direction": {
      "enum": [
        "DOWN",
        "RIGHT"
      ],
      "title": "Direction",
      "type": "string"
    },
    "nodes": {
      "items": {
        "$ref": "#/$defs/FlowNode"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Nodes",
      "type": "array"
    },
    "edges": {
      "items": {
        "$ref": "#/$defs/FlowEdge"
      },
      "title": "Edges",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "diagram_type",
    "title",
    "direction",
    "nodes",
    "edges"
  ],
  "title": "FlowchartSpec",
  "type": "object",
  "x-domain": "flowchart",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
